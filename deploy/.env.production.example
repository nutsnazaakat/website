NODE_ENV=production
PORT=4400
DB_HOST=your-postgres-host
DB_PORT=5432
DB_USER=your-postgres-user
DB_PASSWORD=replace_me
DB_NAME=nuts_nazaakat
DB_SCHEMA=public
DB_SSL=true
DB_MIGRATIONS_RUN=false
JWT_SECRET=replace_me_with_random_secret_at_least_32_characters
