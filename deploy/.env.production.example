COOKIE_DOMAIN=
CORS_ORIGINS=https://your-shop-domain,https://your-admin-domain
SWAGGER_USER=docs
SWAGGER_PASSWORD=replace_me_with_random_password
TRUST_PROXY_HOPS=2
