NODE_ENV=development
PORT=4400

# Database
DB_HOST=localhost
DB_PORT=5442
DB_USER=nutwala
# Matches docker-compose.yml. Not a secret: a local-only throwaway container whose password
# is already committed there. Any real deployment must override this.
DB_PASSWORD=nutwala_dev_only
DB_NAME=nutwala
DB_SCHEMA=public
DB_MIGRATIONS_RUN=false

# Auth — generate with: openssl rand -base64 48
JWT_SECRET=replace_me_min_32_chars_generate_with_openssl_rand
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# CORS — comma-separated, never *
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Swagger basic auth
SWAGGER_USER=docs
SWAGGER_PASSWORD=replace_me

LOG_LEVEL=debug
